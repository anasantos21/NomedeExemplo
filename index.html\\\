<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Meu Portfólio</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #0f172a;
      color: #f8fafc;
      line-height: 1.6;
    }

    header {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    nav {
      width: 100%;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(10px);
    }

    .logo {
      font-size: 1.5rem;
      font-weight: bold;
      color: #38bdf8;
    }

    nav ul {
      display: flex;
      gap: 30px;
      list-style: none;
    }

    nav a {
      color: #fff;
      text-decoration: none;
      transition: 0.3s;
    }

    nav a:hover {
      color: #38bdf8;
    }

    .hero {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 50px;
      padding: 120px 8% 60px;
      max-width: 1400px;
      width: 100%;
      margin: auto;
    }

    .hero-text {
      max-width: 650px;
    }

    .hero-text span {
      color: #38bdf8;
      font-size: 1.2rem;
      font-weight: bold;
    }

    .hero-text h1 {
      font-size: clamp(2.5rem, 6vw, 5rem);
      line-height: 1.1;
      margin: 15px 0;
    }

    .hero-text h1 strong {
      color: #38bdf8;
    }

    .hero-text p {
      color: #cbd5e1;
      font-size: 1.1rem;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 25px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-primary {
      background: #38bdf8;
      color: #0f172a;
    }

    .btn-primary:hover {
      background: #0ea5e9;
      transform: translateY(-3px);
    }

    .btn-outline {
      border: 1px solid #38bdf8;
      color: #38bdf8;
    }

    .btn-outline:hover {
      background: #38bdf8;
      color: #0f172a;
    }

    .profile {
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: linear-gradient(135deg, #38bdf8, #6366f1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
      box-shadow: 0 0 80px rgba(56, 189, 248, 0.25);
      flex-shrink: 0;
    }

    section {
      padding: 100px 8%;
      max-width: 1400px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title h2 {
      font-size: 2.5rem;
      margin-bottom: 10px;
    }

    .section-title span {
      color: #38bdf8;
    }

    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .about p {
      color: #cbd5e1;
      margin-bottom: 15px;
    }

    .skills {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .skill {
      background: #1e293b;
      padding: 20px;
      border-radius: 10px;
      border-left: 4px solid #38bdf8;
    }

    .projects {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .project {
      background: #1e293b;
      border-radius: 12px;
      overflow: hidden;
      transition: 0.3s;
      border: 1px solid transparent;
    }

    .project:hover {
      transform: translateY(-8px);
      border-color: #38bdf8;
    }

    .project-image {
      height: 180px;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
    }

    .project-content {
      padding: 25px;
    }

    .project-content h3 {
      margin-bottom: 10px;
    }

    .project-content p {
      color: #94a3b8;
      margin-bottom: 20px;
    }

    .contact {
      text-align: center;
    }

    .contact p {
      color: #cbd5e1;
      margin-bottom: 25px;
    }

    .social {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 25px;
    }

    .social a {
      color: #38bdf8;
      text-decoration: none;
    }

    footer {
      text-align: center;
      padding: 30px;
      background: #020617;
      color: #64748b;
    }

    @media (max-width: 900px) {
      .hero {
        flex-direction: column-reverse;
        text-align: center;
        justify-content: center;
      }

      .buttons {
        justify-content: center;
      }

      .profile {
        width: 220px;
        height: 220px;
      }

      .about {
        grid-template-columns: 1fr;
      }

      .projects {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 600px) {
      nav {
        padding: 15px 5%;
      }

      nav ul {
        gap: 12px;
        font-size: 0.85rem;
      }

      .hero {
        padding: 120px 5% 60px;
      }

      section {
        padding: 70px 5%;
      }

      .skills,
      .projects {
        grid-template-columns: 1fr;
      }

      .profile {
        width: 180px;
        height: 180px;
        font-size: 3.5rem;
      }
    }
  </style>
</head>

<body>

  <header id="inicio">

    <nav>
      <div class="logo">MeuPortfólio.</div>

      <ul>
        <li><a href="#inicio">Início</a></li>
